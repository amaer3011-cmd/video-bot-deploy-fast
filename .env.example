API_ID=
API_HASH=
BOT_TOKEN=
ADMIN_IDS=

# مسار قاعدة البيانات (SQLite). لازم يكون جوه مجلد /data المربوط بـ Volume عشان البيانات ما تضيعش.
DB_PATH=/data/bot.db

# Access control: bot starts public; ALLOWED_USERS is used if private mode is selected in the admin panel.
# ADMIN_IDS=111
# ALLOWED_USERS=111,222

# --- يوتيوب: حل مشكلة "Sign in to confirm you're not a bot" ---
# الأسهل: ابعت ملف cookies.txt للبوت من لوحة الأدمن (🍪 كوكيز يوتيوب). أو حطه هنا كـ Base64:
#   Linux/Mac:  base64 -w0 cookies.txt     |  Windows PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("cookies.txt"))
# COOKIES_B64=
# بروكسي سكني (اختياري) لو الكوكيز لوحدها مش كفاية:  http://user:pass@host:port
# PROXY=
# عدد الخيوط للتحميلات المتزامنة (الافتراضي 128)
# THREADS=128

# High-speed profile is the default. Set to custom to honor lower values below.
TRANSFER_PROFILE=fast
UPLOAD_WORKERS=16
CONNECTIONS=24
FRAGMENTS=24

# --- النقل المباشر السريع (fastio.py) ---
# جلسات Media منفصلة للرفع المتوازي × طلبات متوازية لكل الرفع (UPLOAD_WORKERS). 4 جلسات = قيمة آمنة؛ ارفعها لو الاستضافة قوية.
UPLOAD_SESSIONS=4
# يوزر المطور على الزر (بدون @)
DEV_USERNAME=A7med19_7
# (اختياري) سيرفر تحميل خارجي متوافق مع cobalt: بيتجرب تلقائيًا لما يوتيوب/موقع يحجب IP السيرفر
# COBALT_API_URL=https://your-cobalt-instance.example.com
# COBALT_API_KEY=

# --- التقرير اليومي للأدمن ---
# الساعة (بتوقيت UTC) اللي يتبعت فيها التقرير اليومي. 6 = حوالي 8 صباحًا بتوقيت القاهرة. اكتب off للإيقاف.
DAILY_REPORT_HOUR=6

# --- المنطقة الزمنية للتحية (صباح/مساء الخير) ---
# اسم منطقة IANA. الافتراضي Africa/Cairo. لو الصورة مفيهاش tzdata بيستخدم UTC+2 تقريبيًا.
# BOT_TZ=Africa/Cairo
